# ═══════════════════════════════════════════════════════
# AuEdu Server — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy file này thành .env và điền thông tin thực:
#   cp .env.example .env
#
# ⚠️ KHÔNG commit file .env lên GitHub!
# ═══════════════════════════════════════════════════════

# ── Supabase Connection ──
# Đăng ký tại: https://supabase.com → Tạo project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_STORAGE_BUCKET=thongbao_images

# ── Database Connection ──
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Lấy từ Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ── AI Configuration ──
FIQA_THRESHOLD=0.05          # Ngưỡng FIQA tối thiểu (0-1), mặc định 0.05
ANTI_SPOOF_MODEL=modelrgb.onnx  # Model anti-spoofing MiniFASNet

# ── WebSocket Configuration ──
MAX_QUEUE_SIZE=8             # Kích thước queue cho WebSocket producer-consumer
DROP_OLDEST=true             # Khi queue đầy, bỏ frame cũ nhất

# ── Camera Calibration ──
CALIBRATION_MODE=auto        # auto = tự tính ma trận từ chessboard
CALIBRATION_DATA=calib.npy   # File lưu ma trận calibration (git-ignored)
