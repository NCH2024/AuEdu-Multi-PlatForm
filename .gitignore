# ═══════════════════════════════════════════════════════
# AuEdu – .gitignore
# ═══════════════════════════════════════════════════════

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
*.whl

# ── Virtual Environments ──
venv/
.venv/
**/venv/
**/venv-linux/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment & Secrets (QUAN TRỌNG: KHÔNG push secrets lên GitHub) ──
.env
**/.env
*.env.local
*.env.production
# Chỉ track .env.example (không chứa secrets)
!**/.env.example

# ── Build ──
build/
**/build/
*.spec

# ── OS Generated ──
.DS_Store
Thumbs.db
desktop.ini

# ── Calibration (machine-generated) ──
calib.npy

# ═══════════════════════════════════════════════════════
# DATASET & HEAVY FILES (không tải lên GitHub)
# ═══════════════════════════════════════════════════════

# Ảnh dataset LFW (tự tải bằng prepare_dataset.py)
tests/dataset/**
!tests/dataset/
!tests/dataset/.gitkeep

# Kết quả test (JSON/CSV lớn, tự sinh khi chạy)
tests/results/**
!tests/results/
!tests/results/.gitkeep

# scikit-learn cache
scikit_learn_data/

# ── AI Models (tự tải khi chạy InsightFace) ──
Server/app/ai/models/*.onnx
Server/assets/anti_spoof_models/
**/*.onnx

# ── Logs ──
*.log
logs/

# ── Misc ──
*.tmp
*.bak
